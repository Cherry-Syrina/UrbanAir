# =============================================================================
# UrbanAir AI — backend environment (.env.example)
# Copy to urbanair_backend/.env and fill in your own values.
# NEVER commit the real .env file (it is git-ignored).
# =============================================================================

# ---------------------------------------------------------------------------
# Supabase PostgreSQL (OPTIONAL — omit and the backend runs CSV-only)
# ---------------------------------------------------------------------------
# Use the connection string from:
#   Supabase Dashboard -> Project Settings -> Database -> Connection string
# The "Session Pooler" tab is recommended (port 5432) for the web service and
# for the CLI scripts; the "Transaction Pooler" uses port 6543.
# Keep sslmode=require; never disable certificate verification.
#   Session Pooler example:
#   DATABASE_URL=postgresql://postgres.<ref>:<password>@aws-0-<region>.pooler.supabase.com:5432/postgres?sslmode=require
#   Transaction Pooler example:
#   DATABASE_URL=postgresql://postgres.<ref>:<password>@aws-0-<region>.pooler.supabase.com:6543/postgres?sslmode=require
DATABASE_URL=
# Alias accepted if you prefer this name (DATABASE_URL wins if both are set):
SUPABASE_DB_URL=

# Echo SQL statements to logs (dev only). Leave blank/0 in production.
DB_ECHO=0

# ---------------------------------------------------------------------------
# CORS / frontend origin (REQUIRED in production)
# ---------------------------------------------------------------------------
# Comma-separated list of allowed browser origins. In production set this to
# your Vercel URL, e.g. https://urbanair.vercel.app
# If left blank, only the localhost Vite dev server is allowed.
CORS_ORIGINS=
FRONTEND_URL=

# ---------------------------------------------------------------------------
# Email alerts (optional) — only /api/alerts/send needs these.
# ---------------------------------------------------------------------------
# For Gmail: enable 2-Step Verification, then create an App Password at
# https://myaccount.google.com/apppasswords (use that, NOT your normal password).
SMTP_EMAIL=your_email@gmail.com
SMTP_APP_PASSWORD=your_16_char_app_password

# Only change these if not using Gmail
SMTP_HOST=smtp.gmail.com
SMTP_PORT=465

# ---------------------------------------------------------------------------
# Groq arbitration (optional) — powers WAQI-vs-model arbitration in /api/current.
# If blank, arbitration is skipped and the WAQI reading is used directly.
# Free key at: https://console.groq.com/keys
# ---------------------------------------------------------------------------
GROQ_API_KEY=your_groq_key_here
