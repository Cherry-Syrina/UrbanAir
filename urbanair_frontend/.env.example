# Frontend environment (.env.example)
# Copy to urbanair_frontend/.env (git-ignored). Vite only exposes VITE_*
# variables, and they are bundled into the browser — NEVER put secrets here.

# Full base URL of the deployed backend API (include the /api suffix).
# Leave unset in local development to use the Vite proxy ("/api").
# Example: https://urbanair-backend.onrender.com/api
VITE_API_BASE_URL=

# Optional: override the dev-server proxy target (default http://127.0.0.1:8000)
# VITE_DEV_PROXY_TARGET=http://127.0.0.1:8000

# Optional basemap override. Default (unset) uses Esri's public World Dark Gray
# Canvas, which needs no API key. CARTO's free raster CDN now requires a key and
# otherwise shows an "API KEY REQUIRED" watermark; to use a keyed provider set:
#   VITE_MAP_TILE_URL=https://{s}.basemaps.cartocdn.com/dark_all/{z}/{x}/{y}{r}.png?key=YOUR_KEY
# Only public tile URLs belong here; they ship in the browser bundle.
# VITE_MAP_TILE_URL=

# ---------------------------------------------------------------------------
# Supabase (browser client) — OPTIONAL
# The publishable/anon key is client-safe (protected by RLS) and is the only
# Supabase credential that may live in the frontend. NEVER put the
# service-role key or any PostgreSQL password here.
# Not consumed yet: the dashboard currently reads data through the FastAPI
# backend. These are populated so a future @supabase/supabase-js client can
# read them via import.meta.env.VITE_SUPABASE_URL / _PUBLISHABLE_KEY.
# ---------------------------------------------------------------------------
# Get both from: Supabase Dashboard -> Project Settings -> API
VITE_SUPABASE_URL=https://your-project-ref.supabase.co
VITE_SUPABASE_PUBLISHABLE_KEY=your_publishable_key
# Older supabase-js docs call this the "anon" key; the publishable key works
# in the same slot:
# VITE_SUPABASE_ANON_KEY=your_publishable_key
